{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.thegoldbarometer/thegoldbarometer",
  "description": "Today's gold buying-conditions score (0-100), its published history, and what followed since 1971.",
  "repository": {
    "url": "https://github.com/thegoldbarometer/mcp-server",
    "source": "github"
  },
  "version": "1.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "thegoldbarometer-mcp",
      "version": "1.0.1",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "websiteUrl": "https://thegoldbarometer.com/data/",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.thegoldbarometer.com/mcp"
    }
  ]
}
